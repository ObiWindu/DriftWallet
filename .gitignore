# Android local (keep gradle wrapper + app/ committed; ignore local SDK/keystore state)
local.properties
apps/mobile/android/local.properties
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
android/app/google-services.json
ios/GoogleService-Info.plist

# iOS (keep Podfile + Podfile.lock committed; ignore installed Pods + derived data)
apps/mobile/ios/Pods/
ios/Pods/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip

# Android build outputs (keep sources + gradle wrapper; ignore binaries)
*.apk
*.aab
*.aar

# Env + store API keys + credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json
*-token.json
store-api-*.json
play-store-*.json
app-store-*.p8
AuthKey_*.p8

# Extension build output (keep manifests + configs, ignore bundles/zips)
apps/extension/dist/
apps/extension/dist-chrome/
apps/extension/dist-firefox/
apps/extension/*.zip
apps/extension/web-ext-artifacts/
SHA256SUMS

# Generated release evidence (regenerated by CI per release, attached as artifacts)
sbom.json

# Fuzzer working dirs (keep committed corpus seeds, ignore runtime artifacts)
fuzz/artifacts/
**/fuzz/artifacts/
crash-*
oom-*
timeout-*
leak-*

# Patch leftovers
*.orig
*.rej

# Logs / OS / editor artifacts (never commit sessions, swaps, dumps)
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.swp
*.swo
*.kate-swp
*~
.vscode/*
!.vscode/extensions.json
.idea/

# Never commit secrets / fixtures with real seeds
**/fixtures/*secret*
**/*.vault.json

# Agent / assistant session artifacts (prompts, transcripts, local runs)
.opencode/
.Muse/
.claude/
.agent/
*.session
claude.json

# Persona / PII / device data dumps (backups, keychains, DBs, heaps)
*.sqlite*
*.sqlite3*
*.db
*.realm
*.mmkv
*.heapsnapshot
*.hprof
*.dmp
*.mobileprovision

# Personal / internal scratch docs (meeting notes, TODOs with PII)
notes/
scratch/
tmp/
private/
*.private.*
NOTES*.md
*.bak
*.tmp
