    "/v1/sol/tx/{sig}": {
      "get": {
        "summary": "Solana signature status"
      }
    },
    "/v1/swap/quote": {
      "post": {
        "summary": "aggregator quote (0x EVM / Jupiter SOL), unsigned"
      }
    },
    "/v1/nfts/{chain}/{addr}": {
      "get": {
        "summary": "NFT holdings via configured indexer"
      }
