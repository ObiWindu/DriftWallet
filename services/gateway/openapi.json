    "/v1/sol/balance/{addr}": {
      "get": {
        "summary": "Solana native balance (lamports)"
      }
    },
    "/v1/btc/utxo/{addr}": {
      "get": {
        "summary": "BTC UTXO set via Esplora"
      }
    },
    "/v1/ada/utxo/{addr}": {
      "get": {
        "summary": "Cardano address info via Koios"
      }
    },
    "/v1/tokens/{chain}": {
      "get": {
        "summary": "token metadata list for chain"
      }
    },
    "/v1/evm/simulate": {
      "post": {
        "summary": "simulate EVM call, return balance diff"
      }
    },
    "/v1/sol/simulate": {
      "post": {
        "summary": "simulate Solana tx, return balance diff"
      }
