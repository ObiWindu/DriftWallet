{
  "openapi": "3.0.0",
  "info": {
    "title": "drift-gateway",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "health + upstream status"
      }
    },
    "/v1/prices": {
      "get": {
        "summary": "current fiat prices (USD) per asset"
      }
    },
    "/v1/prices/history": {
      "get": {
        "summary": "price history series for sparklines"
      }
    },
    "/v1/phishlist": {
      "get": {
        "summary": "phishing domain list"
      }
    },
    "/v1/push/subscribe": {
      "post": {
        "summary": "subscribe push for hashed address"
      }
    },
    "/v1/push/revoke": {
      "post": {
        "summary": "revoke push for hashed address"
      }
    },
    "/v1/push/unsubscribe": {
      "post": {
        "summary": "unsubscribe push for hashed address"
      }
    },
    "/v1/evm/{chainId}/broadcast": {
      "post": {
        "summary": "broadcast raw EVM tx"
      }
    },
    "/v1/sol/broadcast": {
      "post": {
        "summary": "broadcast signed Solana tx"
      }
    },
    "/v1/btc/broadcast": {
      "post": {
        "summary": "broadcast raw BTC tx via Esplora"
      }
