# --- Gateway upstreams (all optional; empty = stub mode) ---
# GATEWAY_ENV_MODE=stub|live   (empty-string safe; unset = auto-detect)
# EVM_RPC_URL=https://eth-mainnet.example     (fallback for all EVM chains)
# EVM_RPC_URL_1=... EVM_RPC_URL_56=...        (per-chain overrides)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BTC_ESPLORA_URL=https://blockstream.info/api
# ADA_KOIOS_URL=https://api.koios.rest/api/v1
# PRICE_API_URL=https://prices.example.com
# PRICE_HISTORY_URL=                          (defaults to PRICE_API_URL + /history)
# PHISHLIST_URL=                              (dynamic phishing feed)
# SWAP_0X_API_URL=https://api.0x.org  +  ZEROX_API_KEY=
# SWAP_JUPITER_API_URL=https://quote-api.jup.ag/v6
# NFT_API_URL=https://nft.example.com/{chain}/{addr}
